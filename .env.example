# Server Configuration
PORT=3000
NODE_ENV=development

# Seguridad (Esta es la clave que usaras en Postman en el header x-api-key)
API_SECRET_KEY="tu_clave_secreta_aqui"

# Conexion a PostgreSQL (Para tu pgAdmin local)
# Formato: postgresql://USUARIO:CONTRASENA@localhost:5432/notifier_db
# Debes cambiar TU_CONTRASENA_DE_PGADMIN por la contrasena que usas para entrar a pgAdmin
DATABASE_URL="postgresql://postgres:TU_CONTRASENA_DE_PGADMIN@localhost:5432/notifier_db"

# Configuracion de Correos (SMTP)
# El agente puso "example.com", eso dara error al probar en Postman. 
# Si vas a usar Gmail para pruebas, configuralo asi:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="tu_correo_real@gmail.com"
# Si usas Gmail, no es tu contrasena normal, debes generar una "Contrasena de aplicacion" en los ajustes de seguridad de tu cuenta de Google
SMTP_PASS="tu_contrasena_de_aplicacion_de_gmail"
SMTP_FROM="Notifier <tu_correo_real@gmail.com>"

# Reglas del OTP
OTP_EXPIRATION_SECONDS=600
OTP_MAX_ATTEMPTS=3